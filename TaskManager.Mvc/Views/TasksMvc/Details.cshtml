@model TaskManager.Mvc.Models.TaskItem

@{
    ViewData["Title"] = "Task Details";
}

<div class="container mt-5">
    <div class="glass-bg p-5 rounded-4 shadow shadow-sm max-width-600 mx-auto">
        <h1 class="display-6 fw-bold mb-4">Task Details</h1>
        
        <div class="mb-4 d-flex align-items-center gap-3">
             <span class="fs-4 fw-bold">ID: @Model.Id</span>
             @if (Model.IsCompleted)
             {
                 <span class="badge rounded-pill bg-success px-4 py-2 border border-success">Completed</span>
             }
             else
             {
                 <span class="badge rounded-pill bg-warning px-4 py-2 border border-warning text-dark">Pending</span>
             }
        </div>

        <div class="mb-4">
            <label class="text-muted small text-uppercase fw-bold">Title</label>
            <p class="fs-3 fw-bold">@Model.Title</p>
        </div>

        <div class="mb-4">
            <label class="text-muted small text-uppercase fw-bold">Description</label>
            <p class="fs-5 text-secondary">@Model.Description</p>
        </div>

        <div class="row g-3 mb-5">
            <div class="col-6">
                <label class="text-muted small text-uppercase fw-bold">Created On</label>
                <p class="fs-5">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
            </div>
            <div class="col-6">
                <label class="text-muted small text-uppercase fw-bold">Due Date</label>
                <p class="fs-5">@(Model.DueDate?.ToString("MMM dd, yyyy") ?? "No date set")</p>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to List</a>
            <a href="http://localhost:4200/edit/@Model.Id" target="_blank" class="btn btn-primary rounded-pill px-4">Edit Task (Angular App)</a>
        </div>
    </div>
</div>

<style>
    .glass-bg {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        max-width: 700px;
    }
</style>
