@{
    ViewData["Title"] = "Task Management Portal";
}

<div class="container py-5 text-center">
    <div class="glass-bg p-5 rounded-4 shadow-lg animate-fade-in mx-auto" style="max-width: 800px;">
        <h1 class="display-3 fw-bold mb-3 gradient-text">Welcome to Task Master</h1>
        <p class="fs-4 text-secondary mb-5">Your unified portal for managing tasks with server-side excellence.</p>
        
        <div class="row g-4 justify-content-center">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">📋</div>
                        <h3 class="fw-bold">View Tasks</h3>
                        <p class="text-muted small">Access the server-rendered task list directly from the database.</p>
                        <a asp-controller="TasksMvc" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-3">View Now</a>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">⚡</div>
                        <h3 class="fw-bold">Angular App</h3>
                        <p class="text-muted small">Head over to the interactive SPA for real-time task management.</p>
                        <a href="http://localhost:4200" target="_blank" class="btn btn-outline-primary rounded-pill px-4 mt-3">Open App</a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-5 pt-4 border-top border-light">
            <p class="text-secondary small">This MVC application is connected to the same Web API as the Angular frontend.</p>
            <a href="http://localhost:5219/swagger" target="_blank" class="text-primary text-decoration-none fw-semibold">Browse API Documentation &rarr;</a>
        </div>
    </div>
</div>

<style>
    .glass-bg {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.4);
    }
    
    .gradient-text {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .feature-icon {
        font-size: 3rem;
    }
    
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
